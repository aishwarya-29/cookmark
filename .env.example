# Base URL of the extraction Worker. Leave unset until Step 4 deploys one.
#
# Unset is a fully supported state: Tiers 1 and 2 are skipped, everything
# settles at Tier 3, and the app works as a link organiser (FR-2.7).
#
# Do NOT point this at a URL that isn't serving — every save will then wait for
# the 8s metadata timeout before settling.
# VITE_WORKER_URL=https://reel-recipes-worker.<your-subdomain>.workers.dev
